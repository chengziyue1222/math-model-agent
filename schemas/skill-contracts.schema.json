{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standard Skill Contract Catalogue",
  "type": "object",
  "required": ["contract_version", "skills"],
  "properties": {
    "contract_version": {"enum": ["1.1", "1.2", "1.3", "1.4", "1.5"]},
    "profile": {"enum": ["rapid", "competition", "audit"]},
    "venue": {"enum": ["CUMCM", "MCM/ICM", "MathorCup", "journal", "generic-research-report"]},
    "skills": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {
        "type": "object",
        "required": ["inputs", "outputs"],
        "properties": {
          "inputs": {"type": "array", "items": {"type": "string"}},
          "outputs": {"type": "array", "items": {"type": "string"}},
          "one_of_inputs": {"type": "array", "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
        }
      }
    }
  },
  "allOf": [{"if": {"properties": {"contract_version": {"const": "1.5"}}}, "then": {"required": ["profile", "venue"]}}]
}
